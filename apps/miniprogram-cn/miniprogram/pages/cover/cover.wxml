<!-- miniprogram/pages/cover/cover.wxml -->
<view class="portal-container">
  
  <!-- 1. Apple-Style Header -->
  <view class="portal-header">
    <text class="brand-tag">HABIT & VISION SYSTEM</text>
    <view class="brand-name">儿童习惯与视觉伴学中心</view>
    <view class="brand-slogan">专注于培养孩子良好端正坐姿习惯与健康用眼自律</view>
  </view>

  <!-- 2. Unified Registration & Child Profile (Apple Grouped Style) -->
  <view class="profile-strip">
    <view class="user-cell">
      <view class="user-avatar">
        <text class="avatar-letter">P</text>
      </view>
      <view class="user-meta">
        <text class="user-title">{{isLoggedIn ? '家庭家长中心' : '微信一键授权注册'}}</text>
        <text class="user-sub">{{isLoggedIn ? '统一账号已绑定 · 档案全域互通' : '登录后建立孩子习惯与视力成长档案'}}</text>
      </view>
      <button wx:if="{{!isLoggedIn}}" class="btn-quick-login" bindtap="handleLogin">登录</button>
      <view wx:else class="badge-synced">已同步</view>
    </view>

    <!-- Unified Child Switcher (Apple Segmented Style) -->
    <view class="child-picker" wx:if="{{isLoggedIn}}">
      <text class="picker-label">当前受试：</text>
      <view class="picker-tabs">
        <view class="tab-item {{activeChild === 'child_1' ? 'selected' : ''}}" bindtap="switchChild" data-child="child_1">
          <text>大宝 (10岁)</text>
        </view>
        <view class="tab-item {{activeChild === 'child_2' ? 'selected' : ''}}" bindtap="switchChild" data-child="child_2">
          <text>二宝 (7岁)</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 3. Two Independent Flagship Paths (Apple HIG Cards) -->
  <view class="tracks-wrapper">
    <view class="tracks-heading">功能路线选择</view>

    <!-- 路线一：眼脑协调与注意力测试 -->
    <view class="track-box track-eyebrain" bindtap="navToEyeBrain">
      <view class="track-kicker text-blue">EYE-BRAIN COORDINATION</view>
      <view class="track-headline">眼脑协调专注力测试</view>
      <view class="track-summary">视听觉引导小互动 · 视知觉与反应力 · 阶段性趣味测评</view>
      <view class="track-footer">
        <text class="footer-tip">阶段性测试 · 评估视知觉协调状态</text>
        <text class="footer-arrow">进入测验 ➔</text>
      </view>
    </view>

    <!-- 路线二：AI 坐姿习惯伴学魔镜 -->
    <view class="track-box track-posture" bindtap="navToPostureMirror">
      <view class="track-kicker text-green">POSTURE COMPANION</view>
      <view class="track-headline">AI 护眼坐姿伴学魔镜</view>
      <view class="track-summary">单机两用/旧机常驻 · OLED 纯黑屏防分心 · 500 Lux 台灯监控 · 每日背脊简报</view>
      <view class="track-footer">
        <text class="footer-tip">日常写作业使用 · 自动记录专注时长与坐姿</text>
        <text class="footer-arrow arrow-green">开启伴学 ➔</text>
      </view>
    </view>
  </view>

  <!-- 4. Apple Minimalist Footnote -->
  <view class="legal-footnote">
    <text>非医疗机构 · 专注儿童日常作业良好体态习惯养成与用眼健康自律培育</text>
    <view class="brand-footer-sub">Designed in Tokyo · Made in Shanghai</view>
  </view>

</view>
