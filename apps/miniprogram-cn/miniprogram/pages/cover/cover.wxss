/* miniprogram/pages/cover/cover.wxss */
.portal-container {
  min-height: 100vh;
  background-color: #f8fafc;
  color: #0f172a;
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

.portal-header {
  text-align: center;
  margin-bottom: 36rpx;
  padding-top: 10rpx;
}

.brand-tag {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #0284c7;
  background: #e0f2fe;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
  text-transform: uppercase;
}

.brand-name {
  font-size: 48rpx;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: -0.5rpx;
  margin-bottom: 10rpx;
}

.brand-slogan {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.45;
}

/* Profile Strip */
.profile-strip {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.03);
}

.user-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.user-avatar {
  width: 76rpx;
  height: 76rpx;
  background: #e0f2fe;
  border-radius: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  border: 1rpx solid #bae6fd;
}

.avatar-letter {
  font-size: 30rpx;
  font-weight: 800;
  color: #0284c7;
}

.user-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
}

.user-sub {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.btn-quick-login {
  background: #0284c7 !important;
  color: #ffffff !important;
  font-size: 26rpx !important;
  font-weight: 700 !important;
  padding: 10rpx 28rpx !important;
  border-radius: 30rpx !important;
  margin: 0 !important;
}

.badge-synced {
  background: #e0f2fe;
  color: #0284c7;
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 18rpx;
  border-radius: 16rpx;
}

.child-picker {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f1f5f9;
  display: flex;
  align-items: center;
}

.picker-label {
  font-size: 24rpx;
  color: #64748b;
  margin-right: 16rpx;
}

.picker-tabs {
  display: flex;
  gap: 12rpx;
}

.tab-item {
  padding: 8rpx 24rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  background: #f1f5f9;
  color: #64748b;
  border: 1rpx solid #e2e8f0;
}

.tab-item.selected {
  background: #0284c7;
  color: #ffffff;
  border-color: #0284c7;
  font-weight: 700;
}

/* Tracks */
.tracks-wrapper {
  margin-bottom: 36rpx;
}

.tracks-heading {
  font-size: 26rpx;
  font-weight: 700;
  color: #64748b;
  letter-spacing: 1rpx;
  margin-bottom: 20rpx;
  text-transform: uppercase;
}

.track-box {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.04);
  display: flex;
  flex-direction: column;
}

.track-eyebrain {
  border-left: 8rpx solid #0284c7;
}

.track-posture {
  border-left: 8rpx solid #10b981;
}

.track-kicker {
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
  text-transform: uppercase;
}

.text-blue { color: #0284c7; }
.text-green { color: #059669; }

.track-headline {
  font-size: 38rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 10rpx;
}

.track-summary {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.track-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #f1f5f9;
  padding-top: 20rpx;
}

.footer-tip {
  font-size: 22rpx;
  color: #94a3b8;
}

.footer-arrow {
  font-size: 26rpx;
  font-weight: 700;
  color: #0284c7;
}

.arrow-green {
  color: #059669;
}

/* Legal Non-Medical Footnote */
.legal-footnote {
  text-align: center;
  padding: 16rpx 10rpx 28rpx;
}

.legal-footnote text {
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.5;
  display: block;
}

.brand-footer-sub {
  font-size: 20rpx;
  color: #cbd5e1;
  margin-top: 6rpx;
  letter-spacing: 2rpx;
}
