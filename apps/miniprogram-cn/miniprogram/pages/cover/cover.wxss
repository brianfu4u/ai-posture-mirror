/* miniprogram/pages/cover/cover.wxss */
.portal-container {
  min-height: 100vh;
  background-color: #070b14;
  color: #f8fafc;
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

.portal-header {
  text-align: center;
  margin-bottom: 40rpx;
  padding-top: 10rpx;
}
.brand-tag {
  display: inline-block;
  background: rgba(16, 185, 129, 0.15);
  border: 1px solid rgba(16, 185, 129, 0.4);
  color: #34d399;
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 22rpx;
  border-radius: 30rpx;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}
.brand-name {
  font-size: 42rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 1.5rpx;
}
.brand-slogan {
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 10rpx;
}

/* Unified Profile Strip */
.profile-strip {
  background: #131c2e;
  border: 1px solid #1e293b;
  border-radius: 26rpx;
  padding: 28rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 10rpx 25rpx rgba(0, 0, 0, 0.35);
}
.user-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.user-avatar {
  width: 76rpx;
  height: 76rpx;
  background: #1e293b;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  margin-right: 20rpx;
  border: 1px solid #334155;
}
.user-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.user-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #f1f5f9;
}
.user-sub {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 6rpx;
}
.btn-quick-login {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  padding: 10rpx 26rpx;
  border-radius: 30rpx;
  margin: 0;
  line-height: 1.5;
}
.badge-synced {
  background: rgba(56, 189, 248, 0.15);
  border: 1px solid rgba(56, 189, 248, 0.4);
  color: #38bdf8;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.child-picker {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1px solid #1e293b;
  display: flex;
  align-items: center;
}
.picker-label {
  font-size: 22rpx;
  color: #94a3b8;
  margin-right: 15rpx;
}
.picker-tabs {
  display: flex;
  gap: 15rpx;
}
.tab-item {
  padding: 8rpx 22rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  background: #0b0f19;
  color: #94a3b8;
  border: 1px solid #1e293b;
}
.tab-item.selected {
  background: #2563eb;
  color: #ffffff;
  border-color: #3b82f6;
  font-weight: 700;
}

/* Tracks */
.tracks-wrapper {
  margin-bottom: 40rpx;
}
.tracks-heading {
  font-size: 26rpx;
  font-weight: 700;
  color: #94a3b8;
  margin-bottom: 22rpx;
  padding-left: 8rpx;
}
.track-box {
  background: #131c2e;
  border-radius: 30rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 15rpx 30rpx rgba(0, 0, 0, 0.4);
  border: 1.5px solid #1e293b;
}
.track-eyebrain {
  border-color: rgba(56, 189, 248, 0.35);
  background: linear-gradient(135deg, rgba(19, 28, 46, 0.95) 0%, rgba(11, 15, 25, 0.95) 100%);
}
.track-posture {
  border-color: rgba(16, 185, 129, 0.4);
  background: linear-gradient(135deg, rgba(6, 78, 59, 0.2) 0%, rgba(11, 15, 25, 0.95) 100%);
}
.track-badge-pill {
  display: inline-block;
  font-size: 18rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  margin-bottom: 14rpx;
}
.pill-blue {
  background: rgba(56, 189, 248, 0.15);
  color: #38bdf8;
  border: 1px solid rgba(56, 189, 248, 0.35);
}
.pill-green {
  background: rgba(16, 185, 129, 0.15);
  color: #34d399;
  border: 1px solid rgba(16, 185, 129, 0.35);
}
.track-main-row {
  display: flex;
  align-items: center;
}
.track-emojis {
  font-size: 54rpx;
  margin-right: 22rpx;
}
.track-info {
  flex: 1;
}
.track-headline {
  font-size: 32rpx;
  font-weight: 800;
  color: #ffffff;
}
.track-summary {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 8rpx;
  line-height: 1.5;
}
.track-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  padding-top: 16rpx;
  margin-top: 20rpx;
}
.footer-tip {
  font-size: 20rpx;
  color: #cbd5e1;
}
.footer-arrow {
  font-size: 22rpx;
  font-weight: 700;
  color: #38bdf8;
}
.arrow-green {
  color: #34d399;
}

/* Legal Non-Medical Footnote */
.legal-footnote {
  text-align: center;
  padding: 20rpx 10rpx;
}
.legal-footnote text {
  font-size: 20rpx;
  color: #64748b;
  letter-spacing: 1rpx;
}
