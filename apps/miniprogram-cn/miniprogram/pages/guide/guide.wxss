/* miniprogram/pages/guide/guide.wxss */
.guide-container {
  padding: 32rpx;
  background-color: #f8fafc;
  min-height: 100vh;
  box-sizing: border-box;
}

.guide-header {
  margin-bottom: 24rpx;
}

.guide-kicker {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #0284c7;
  text-transform: uppercase;
  display: block;
  margin-bottom: 6rpx;
}

.guide-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #0f172a;
}

.content-white-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.03);
  margin-bottom: 28rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.blue-pill-bar {
  width: 8rpx;
  height: 32rpx;
  background: #0284c7;
  border-radius: 4rpx;
}

.section-title-text {
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
}

.section-paragraph {
  font-size: 26rpx;
  color: #475569;
  line-height: 1.65;
  margin-bottom: 20rpx;
}

.text-highlight {
  color: #0284c7;
  font-weight: 700;
}

.mat-schematic-box {
  background: #f1f5f9;
  border: 1rpx dashed #cbd5e1;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 28rpx;
}

.schematic-corner {
  background: #ffffff;
  border: 1rpx solid #0284c7;
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
}

.corner-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #0284c7;
}

.corner-desc {
  font-size: 20rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.schematic-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.dashed-vertical-line {
  width: 2rpx;
  height: 24rpx;
  border-left: 2rpx dashed #0284c7;
  margin-bottom: 6rpx;
}

.arrow-indicator {
  font-size: 22rpx;
  font-weight: 700;
  color: #0284c7;
}

.chest-distance {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.step-bullet-item {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.step-bullet-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.step-badge-circle {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: #e0f2fe;
  color: #0284c7;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step-text-col {
  flex: 1;
}

.step-head {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 4rpx;
}

.step-sub {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.45;
}

/* 视频播放卡片 */
.video-section-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.03);
  margin-bottom: 28rpx;
}
.video-header-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 20rpx;
}
.video-section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
}
.video-player-box {
  width: 100%;
  height: 380rpx;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  background: #0f172a;
}
.video-cover {
  width: 100%;
  height: 100%;
  background: linear-gradient(145deg, #1e293b 0%, #0f172a 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}
.video-play-btn {
  width: 90rpx;
  height: 90rpx;
  border-radius: 45rpx;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.3);
  margin-bottom: 20rpx;
}
.play-arrow {
  width: 0;
  height: 0;
  border-top: 16rpx solid transparent;
  border-bottom: 16rpx solid transparent;
  border-left: 26rpx solid #0284c7;
  margin-left: 6rpx;
}
.video-duration-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: rgba(0, 0, 0, 0.7);
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}
.video-title-overlay {
  font-size: 24rpx;
  color: #e2e8f0;
  font-weight: 600;
}
.native-video {
  width: 100%;
  height: 100%;
}
