/* miniprogram/pages/home/home.wxss */
.bento-container {
  padding: 28rpx 32rpx 48rpx;
  background-color: #f8fafc;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.user-strip-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.03);
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.user-avatar-circle {
  width: 76rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: #e0f2fe;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  border: 1rpx solid #bae6fd;
}

.avatar-inner-icon {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #0284c7;
}

.user-info-col {
  flex: 1;
}

.user-name-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
}

.user-status-pill {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
}

.status-prefix {
  font-size: 22rpx;
  color: #64748b;
}

.status-child-name {
  font-size: 22rpx;
  font-weight: 700;
  color: #0284c7;
}

.user-switch-link {
  font-size: 24rpx;
  color: #94a3b8;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.chevron {
  font-size: 30rpx;
  line-height: 1;
}

.bento-grid-2x2 {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.bento-cell {
  width: calc(50% - 10rpx);
  height: 250rpx;
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.03);
}

.cell-dark {
  background: #1e293b;
  border: 1rpx solid #0f172a;
}

.cell-white {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
}

.cell-top-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.cell-code {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1.5rpx;
  color: #94a3b8;
  text-transform: uppercase;
}

.text-cyan {
  color: #38bdf8;
}

.play-icon-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-triangle {
  width: 0;
  height: 0;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-left: 16rpx solid #ffffff;
  margin-left: 4rpx;
}

.icon-mini {
  font-size: 36rpx;
  line-height: 1;
}

.icon-chart {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 36rpx;
}

.chart-bar {
  width: 8rpx;
  background: #0284c7;
  border-radius: 2rpx;
}

.bar-1 { height: 16rpx; background: #38bdf8; }
.bar-2 { height: 28rpx; background: #0284c7; }
.bar-3 { height: 36rpx; background: #10b981; }

.cell-bottom-box {
  display: flex;
  flex-direction: column;
}

.cell-main-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
}

.cell-sub-en {
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 1.5rpx;
  color: #94a3b8;
  margin-top: 4rpx;
  text-transform: uppercase;
}

.text-white { color: #ffffff; }
.text-muted { color: #64748b; }

.horizontal-strip-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.sub-cell-half {
  flex: 1;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.02);
}

.sub-cell-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.sub-icon {
  font-size: 32rpx;
}

.sub-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
}

.chevron-sm {
  font-size: 28rpx;
  color: #cbd5e1;
}

/* 预约专家条形卡片 */
.booking-strip-card {
  background: #ffffff;
  border: 2rpx solid #0f172a;
  border-radius: 32rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.05);
}

.booking-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.booking-avatar-icon {
  font-size: 38rpx;
}

.booking-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #0f172a;
}

.booking-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.booking-en {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #64748b;
}

.booking-blue-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #38bdf8;
  box-shadow: 0 0 10rpx #38bdf8;
}

.bento-footer {
  margin-top: auto;
  text-align: center;
  padding: 16rpx 0 24rpx;
}

.footer-version {
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #94a3b8;
}
