<!-- miniprogram/pages/index/index.wxml -->
<view class="bento-container">

  <!-- 1. 顶部用户身份与受试孩子卡片 (与眼脑测试系统完全一致) -->
  <view class="user-strip-card">
    <view class="user-avatar-circle">
      <view class="avatar-inner-icon"></view>
    </view>
    <view class="user-info-col">
      <view class="user-name-title">您好，傅</view>
      <view class="user-status-pill">
        <text class="status-prefix">当前守护：</text>
        <text class="status-child-name">{{ activeChildId === 'child_2' ? '二宝 (7岁)' : '大宝 (10岁)' }}</text>
      </view>
    </view>
    <view class="user-switch-link" bindtap="toggleChild">
      <text>切换宝贝</text>
      <text class="chevron">›</text>
    </view>
  </view>

  <!-- 2. 核心 2x2 Bento 四宫格 (与眼脑测试系统完全一致的模块排布) -->
  <view class="bento-grid-2x2">

    <!-- 格子 1：书桌伴学 (旗舰深蓝卡片) -->
    <view class="bento-cell cell-dark" bindtap="startDeskCompanion">
      <view class="cell-top-row">
        <text class="cell-code text-cyan">SESSION_01</text>
        <view class="play-icon-circle">
          <view class="play-triangle"></view>
        </view>
      </view>
      <view class="cell-bottom-box">
        <view class="cell-main-title text-white">书桌伴学</view>
        <view class="cell-sub-en text-muted">COMPANION</view>
      </view>
    </view>

    <!-- 格子 2：分析报告 (白色卡片) -->
    <view class="bento-cell cell-white" bindtap="openReportCenter">
      <view class="cell-top-row">
        <text class="cell-code">DATA_02</text>
        <view class="icon-mini icon-chart">
          <view class="chart-bar bar-1"></view>
          <view class="chart-bar bar-2"></view>
          <view class="chart-bar bar-3"></view>
        </view>
      </view>
      <view class="cell-bottom-box">
        <view class="cell-main-title">分析报告</view>
        <view class="cell-sub-en">REPORT</view>
      </view>
    </view>

    <!-- 格子 3：安装指南 (白色卡片) -->
    <view class="bento-cell cell-white" bindtap="openGuidePage">
      <view class="cell-top-row">
        <text class="cell-code">GUIDE_03</text>
        <view class="icon-mini icon-bulb">💡</view>
      </view>
      <view class="cell-bottom-box">
        <view class="cell-main-title">安装指南</view>
        <view class="cell-sub-en">SETUP GUIDE</view>
      </view>
    </view>

    <!-- 格子 4：产品说明 (白色卡片) -->
    <view class="bento-cell cell-white" bindtap="openIntroPage">
      <view class="cell-top-row">
        <text class="cell-code">INFO_04</text>
        <view class="icon-mini icon-doc">📄</view>
      </view>
      <view class="cell-bottom-box">
        <view class="cell-main-title">产品说明</view>
        <view class="cell-sub-en">INTRODUCTION</view>
      </view>
    </view>

  </view>

  <!-- 3. 横向双分卡片 (商城 + 离线断网模式) -->
  <view class="horizontal-strip-row">
    <!-- 官方商城 -->
    <view class="sub-cell-half" bindtap="navToMall">
      <view class="sub-cell-left">
        <text class="sub-icon">🛒</text>
        <text class="sub-title">官方商城</text>
      </view>
      <text class="chevron-sm">›</text>
    </view>

    <!-- 离线断网模式开关 -->
    <view class="sub-cell-half">
      <view class="sub-cell-left">
        <text class="sub-icon">🛡️</text>
        <view class="offline-label-col">
          <text class="sub-title">离线断网</text>
          <text class="sub-hint-tag">100%本地</text>
        </view>
      </view>
      <switch class="mini-switch" checked="{{offlineModeEnabled}}" bindchange="toggleOfflineMode" color="#0284c7" />
    </view>
  </view>

  <!-- 4. 单机 / 双机模式切换长条按钮 -->
  <view class="mode-toggle-pill-card" bindtap="toggleSystemMode">
    <view class="mode-left-meta">
      <view class="mode-dot"></view>
      <view class="mode-text-wrap">
        <text class="mode-headline">
          {{ systemMode === 'single' ? '单机两用模式 (一部手机搞定 · 免下载)' : '双机常态联动 (旧手机放书桌 · 随时看报告)' }}
        </text>
      </view>
    </view>
    <view class="mode-right-action">
      <text class="action-txt">切换</text>
      <text class="chevron-blue">›</text>
    </view>
  </view>

  <!-- 5. 底部版本号与法律声明 (与原系统完全一致) -->
  <view class="bento-footer">
    <view class="footer-version">V2.2.0 · POSTURE LAB SYSTEM · PROFESSIONAL EDITION</view>
    <view class="footer-declaration">非医疗机构 · 专注儿童作业良好体态与健康用眼自律培养</view>
  </view>

  <!-- 断网开启温馨提示浮层 -->
  <view wx:if="{{showOfflinePromptModal}}" class="offline-modal-mask" bindtap="closeOfflineModal">
    <view class="offline-modal-card" catchtap="noop">
      <view class="modal-title">专注建议：是否断开网络？</view>
      <view class="modal-body">
        伴学 AI 算法 100% 运行在手机本地，开启飞行模式或断开 Wi-Fi 可以彻底阻断微信消息与来电骚扰，让孩子全心专注作业。
      </view>
      <view class="modal-actions-col">
        <button class="btn-primary-blue" bindtap="confirmStartOffline">
          已断网 / 开启飞行，开始伴学
        </button>
        <button class="btn-sub-gray" bindtap="confirmStartOnline">
          保持联网，直接开始
        </button>
      </view>
    </view>
  </view>

</view>
