/* pages/index/index.wxss */
.header-card {
  margin-bottom: 20rpx;
}
.device-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.device-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #f1f5f9;
}
.device-status {
  font-size: 22rpx;
  color: #94a3b8;
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}
.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}
.status-dot.online {
  background-color: #10b981;
}
.status-dot.offline {
  background-color: #64748b;
}
.scan-btn {
  background: #334155 !important;
  color: #cbd5e1 !important;
  border-radius: 30rpx !important;
  font-size: 22rpx !important;
  padding: 8rpx 24rpx !important;
  border: 1rpx solid #475569 !important;
}

.summary-card {
  background: linear-gradient(135deg, #1e293b, #0f172a);
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #cbd5e1;
  margin-bottom: 24rpx;
}
.grid-3 {
  display: flex;
  justify-content: space-around;
  text-align: center;
}
.grid-value {
  font-size: 44rpx;
  font-weight: 800;
  font-family: monospace;
}
.text-emerald { color: #34d399; }
.text-blue { color: #60a5fa; }
.text-amber { color: #fbbf24; }
.unit {
  font-size: 22rpx;
  font-weight: normal;
  color: #94a3b8;
}
.grid-label {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 6rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  margin-bottom: 16rpx;
}
.sub-label {
  font-size: 20rpx;
  color: #64748b;
}

.session-item {
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.session-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.session-time {
  font-size: 26rpx;
  font-weight: 600;
  color: #e2e8f0;
}
.gold-badge {
  background: rgba(245, 158, 11, 0.2);
  border: 1rpx solid #f59e0b;
  color: #fbbf24;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-weight: bold;
}
.session-stats {
  font-size: 22rpx;
  color: #94a3b8;
  display: flex;
  gap: 24rpx;
}

.empty-card {
  text-align: center;
  padding: 60rpx 40rpx;
}
.empty-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: 16rpx;
}
.empty-text {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
}
