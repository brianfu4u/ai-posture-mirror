/* miniprogram/pages/index/index.wxss */
.bento-container {
  padding: 28rpx 32rpx 48rpx;
  background-color: #f8fafc;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* ==================== 1. 顶部用户身份与受试孩子卡片 ==================== */
.user-strip-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.03);
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.user-avatar-circle {
  width: 76rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: #e0f2fe;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  border: 1rpx solid #bae6fd;
}

.avatar-inner-icon {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #0284c7;
}

.user-info-col {
  flex: 1;
}

.user-name-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
}

.user-status-pill {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
}

.status-prefix {
  font-size: 22rpx;
  color: #64748b;
}

.status-child-name {
  font-size: 22rpx;
  font-weight: 700;
  color: #0284c7;
}

.user-switch-link {
  font-size: 24rpx;
  color: #94a3b8;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.chevron {
  font-size: 30rpx;
  line-height: 1;
}

/* ==================== 2. 核心 2x2 Bento 四宫格 ==================== */
.bento-grid-2x2 {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.bento-cell {
  width: calc(50% - 10rpx);
  height: 250rpx;
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.03);
}

.cell-dark {
  background: #1e293b;
  border: 1rpx solid #0f172a;
}

.cell-white {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
}

.cell-top-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.cell-code {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1.5rpx;
  color: #94a3b8;
  text-transform: uppercase;
}

.text-cyan {
  color: #38bdf8;
}

.play-icon-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-triangle {
  width: 0;
  height: 0;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-left: 16rpx solid #ffffff;
  margin-left: 4rpx;
}

.icon-mini {
  font-size: 36rpx;
  line-height: 1;
}

.icon-chart {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 36rpx;
}

.chart-bar {
  width: 8rpx;
  background: #0284c7;
  border-radius: 2rpx;
}

.bar-1 { height: 16rpx; background: #38bdf8; }
.bar-2 { height: 28rpx; background: #0284c7; }
.bar-3 { height: 36rpx; background: #10b981; }

.cell-bottom-box {
  display: flex;
  flex-direction: column;
}

.cell-main-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: 0.5rpx;
}

.cell-sub-en {
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 1.5rpx;
  color: #94a3b8;
  margin-top: 4rpx;
  text-transform: uppercase;
}

.text-white {
  color: #ffffff;
}

.text-muted {
  color: #64748b;
}

/* ==================== 3. 横向双分卡片 (商城 + 离线断网) ==================== */
.horizontal-strip-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.sub-cell-half {
  flex: 1;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.02);
}

.sub-cell-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.sub-icon {
  font-size: 32rpx;
}

.sub-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
}

.offline-label-col {
  display: flex;
  flex-direction: column;
}

.sub-hint-tag {
  font-size: 18rpx;
  color: #0284c7;
  font-weight: 600;
}

.chevron-sm {
  font-size: 28rpx;
  color: #cbd5e1;
}

.mini-switch {
  transform: scale(0.75);
}

/* ==================== 4. 单机/双机模式切换长条卡片 ==================== */
.mode-toggle-pill-card {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.02);
}

.mode-left-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.mode-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #0284c7;
}

.mode-headline {
  font-size: 24rpx;
  font-weight: 700;
  color: #0f172a;
}

.mode-right-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.action-txt {
  font-size: 22rpx;
  color: #0284c7;
  font-weight: 600;
}

.chevron-blue {
  font-size: 28rpx;
  color: #0284c7;
}

/* ==================== 5. 底部版本号与法律声明 ==================== */
.bento-footer {
  margin-top: auto;
  text-align: center;
  padding: 16rpx 0 24rpx;
}

.footer-version {
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #94a3b8;
  margin-bottom: 6rpx;
}

.footer-declaration {
  font-size: 20rpx;
  color: #64748b;
  line-height: 1.5;
}

/* ==================== 断网提示浮层 ==================== */
.offline-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  z-index: 999;
}

.offline-modal-card {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.15);
  text-align: center;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 16rpx;
}

.modal-body {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.55;
  margin-bottom: 32rpx;
}

.modal-actions-col {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn-primary-blue {
  background: #0284c7 !important;
  color: #ffffff !important;
  font-size: 28rpx !important;
  font-weight: 700 !important;
  border-radius: 36rpx !important;
  padding: 20rpx 0 !important;
}

.btn-sub-gray {
  background: #f1f5f9 !important;
  color: #64748b !important;
  font-size: 26rpx !important;
  border-radius: 36rpx !important;
  padding: 18rpx 0 !important;
}
