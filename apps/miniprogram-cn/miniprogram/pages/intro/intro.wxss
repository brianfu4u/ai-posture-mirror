/* miniprogram/pages/intro/intro.wxss */
.intro-container {
  padding: 32rpx;
  background-color: #f8fafc;
  min-height: 100vh;
  box-sizing: border-box;
}

.intro-header {
  margin-bottom: 24rpx;
}

.intro-kicker {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #0284c7;
  text-transform: uppercase;
  display: block;
  margin-bottom: 6rpx;
}

.intro-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #0f172a;
}

/* 黄色重要提示卡片 */
.notice-yellow-card {
  background: #fffbeb;
  border: 1rpx solid #fef3c7;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.notice-icon {
  font-size: 32rpx;
  line-height: 1.4;
}

.notice-text {
  font-size: 24rpx;
  color: #92400e;
  line-height: 1.55;
  flex: 1;
}

.notice-bold {
  font-weight: 700;
}

/* 白色内容卡片 */
.content-white-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.03);
  margin-bottom: 28rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.blue-pill-bar {
  width: 8rpx;
  height: 32rpx;
  background: #0284c7;
  border-radius: 4rpx;
}

.section-title-text {
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
}

.section-paragraph {
  font-size: 26rpx;
  color: #475569;
  line-height: 1.65;
  margin-bottom: 16rpx;
}

.section-paragraph:last-child {
  margin-bottom: 0;
}

.text-highlight {
  color: #dc2626;
  font-weight: 700;
}

/* M1 - M4 能力项 */
.capability-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.capability-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.cap-badge {
  background: #e0f2fe;
  color: #0284c7;
  font-size: 22rpx;
  font-weight: 800;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  margin-top: 4rpx;
}

.cap-body {
  flex: 1;
}

.cap-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 4rpx;
}

.cap-desc {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}
