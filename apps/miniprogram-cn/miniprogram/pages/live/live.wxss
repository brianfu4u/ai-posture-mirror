/* miniprogram/pages/live/live.wxss */
.apple-live-page {
  background-color: #000000;
  min-height: 100vh;
  color: #ffffff;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ==================== 1. Stepper Bar ==================== */
.apple-stepper-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx 28rpx 24rpx;
  background: #000000;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.stepper-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0.35;
  transition: all 0.25s ease;
}

.stepper-step.step-active {
  opacity: 1;
}

.step-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #1c1c1e;
  color: #8e8e93;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  margin-bottom: 8rpx;
}

.step-active .step-badge {
  background: #34c759;
  color: #ffffff;
  border-color: #34c759;
}

.step-text {
  font-size: 22rpx;
  color: #8e8e93;
}

.step-active .step-text {
  color: #34c759;
  font-weight: 600;
}

.stepper-dash {
  flex: 1;
  height: 2rpx;
  background: #2c2c2e;
  margin: 0 12rpx 32rpx 12rpx;
}

.stepper-dash.dash-active {
  background: #34c759;
}

/* ==================== 2. Apple Card Panel ==================== */
.apple-card-panel {
  margin: 32rpx;
  padding: 44rpx 36rpx;
  background: #1c1c1e;
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.panel-eyebrow {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #8e8e93;
  margin-bottom: 12rpx;
  text-transform: uppercase;
}

.panel-headline {
  font-size: 42rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -0.6rpx;
  line-height: 1.25;
  margin-bottom: 14rpx;
}

.panel-subcopy {
  font-size: 26rpx;
  color: #8e8e93;
  line-height: 1.5;
  margin-bottom: 36rpx;
}

/* ==================== 3. Schematic / Layout Mock ==================== */
.mat-schematic {
  background: #000000;
  border: 1rpx dashed rgba(255, 255, 255, 0.16);
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  margin-bottom: 36rpx;
}

.schematic-child {
  font-size: 26rpx;
  color: #0a84ff;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.schematic-divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.08);
  margin-bottom: 20rpx;
}

.schematic-stand {
  background: rgba(52, 199, 89, 0.12);
  border: 1rpx solid rgba(52, 199, 89, 0.3);
  border-radius: 16rpx;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
}

.stand-headline {
  font-size: 26rpx;
  font-weight: 600;
  color: #34c759;
}

.stand-detail {
  font-size: 22rpx;
  color: #8e8e93;
  margin-top: 4rpx;
}

/* ==================== 4. Apple Numbered List ==================== */
.apple-numbered-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.list-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.num-bullet {
  font-size: 24rpx;
  font-weight: 700;
  color: #34c759;
  background: rgba(52, 199, 89, 0.15);
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  line-height: 1.3;
}

.row-desc {
  font-size: 28rpx;
  color: #ffffff;
  line-height: 1.5;
  flex: 1;
}

/* ==================== 5. Apple Tips Stack ==================== */
.apple-tips-stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 36rpx;
}

.apple-tip-row {
  background: #2c2c2e;
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 6rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #8e8e93;
  line-height: 1.45;
}

/* ==================== 6. Viewfinder ==================== */
.apple-viewfinder {
  width: 100%;
  height: 440rpx;
  background: #000000;
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36rpx;
  position: relative;
}

.viewfinder-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.reticle-circle {
  width: 180rpx;
  height: 220rpx;
  border: 2rpx dashed #0a84ff;
  border-radius: 50%;
  margin-bottom: 20rpx;
  opacity: 0.85;
}

.reticle-line {
  width: 360rpx;
  height: 1rpx;
  border-top: 2rpx dashed #34c759;
  margin-bottom: 24rpx;
  opacity: 0.85;
}

.reticle-tag {
  font-size: 22rpx;
  color: #8e8e93;
  background: rgba(28, 28, 30, 0.9);
  padding: 6rpx 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.calib-footer {
  margin-bottom: 24rpx;
}

.countdown-label {
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #0a84ff;
  padding: 20rpx 0;
}

/* ==================== 7. Apple Buttons ==================== */
.apple-primary-btn {
  background: #34c759 !important;
  color: #ffffff !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  border-radius: 48rpx !important;
  height: 96rpx !important;
  line-height: 96rpx !important;
  border: none !important;
  width: 100% !important;
}

.apple-secondary-btn {
  background: #2c2c2e !important;
  color: #ffffff !important;
  font-size: 30rpx !important;
  font-weight: 500 !important;
  border-radius: 48rpx !important;
  height: 96rpx !important;
  line-height: 96rpx !important;
  border: none !important;
}

.button-split-row {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

.flex-1 {
  flex: 1;
}

/* ==================== 8. QR / Dual Pair ==================== */
.qr-container {
  display: flex;
  justify-content: center;
  margin-bottom: 36rpx;
}

.qr-clean-card {
  background: #ffffff;
  color: #000000;
  border-radius: 24rpx;
  padding: 36rpx 48rpx;
  text-align: center;
}

.qr-glyph {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.qr-caption {
  font-size: 26rpx;
  font-weight: 600;
}

.qr-sub {
  font-size: 20rpx;
  color: #636366;
  margin-top: 6rpx;
}

.pairing-badge-card {
  background: #000000;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 20rpx;
  padding: 28rpx;
  text-align: center;
  margin-bottom: 32rpx;
}

.code-label {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #8e8e93;
  margin-bottom: 6rpx;
}

.code-value {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #0a84ff;
}

.pairing-action-stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

/* ==================== 9. OLED Screen ==================== */
.apple-oled-screen {
  background-color: #000000;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 36rpx;
  box-sizing: border-box;
}

.screen-warning-border {
  box-shadow: inset 0 0 40rpx rgba(255, 159, 10, 0.35);
}

.oled-status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.oled-badge {
  font-size: 24rpx;
  color: #8e8e93;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.badge-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.dot-cyan { background: #32d74b; }
.dot-green { background: #30d158; }

.btn-exit {
  font-size: 26rpx;
  color: #ff453a;
  padding: 8rpx 16rpx;
}

.oled-clock-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 60rpx;
}

.clock-digits {
  font-size: 140rpx;
  font-weight: 200;
  color: #48484a;
  letter-spacing: 4rpx;
}

.clock-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #8e8e93;
  margin-top: 16rpx;
}

.status-indicator-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.bg-green { background: #34c759; }
.bg-amber { background: #ff9f0a; }

.clock-target {
  font-size: 22rpx;
  color: #3a3a3c;
  margin-top: 18rpx;
}

.apple-instant-banner {
  position: absolute;
  top: 36%;
  left: 6%;
  right: 6%;
  background: rgba(44, 44, 46, 0.95);
  border: 1rpx solid #ff9f0a;
  border-radius: 28rpx;
  padding: 32rpx;
  text-align: center;
  transition: opacity 0.25s ease;
  pointer-events: none;
}

.banner-visible { opacity: 1; }
.banner-hidden { opacity: 0; }

.banner-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffd60a;
  margin-bottom: 6rpx;
}

.banner-sub {
  font-size: 24rpx;
  color: #ffffff;
}

.apple-test-controller {
  background: #1c1c1e;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-top: auto;
}

.controller-title {
  font-size: 22rpx;
  color: #8e8e93;
  text-align: center;
  margin-bottom: 18rpx;
}

.controller-btn-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
}

.ctrl-btn {
  background: #2c2c2e;
  color: #8e8e93;
  font-size: 24rpx;
  padding: 14rpx 22rpx;
  border-radius: 16rpx;
}

.ctrl-active {
  background: rgba(52, 199, 89, 0.2);
  color: #34c759;
}

.ctrl-warn {
  background: rgba(255, 159, 10, 0.2);
  color: #ff9f0a;
}

.ctrl-dim {
  background: #1c1c1e;
  color: #48484a;
}

.controller-metrics {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  font-size: 22rpx;
  color: #8e8e93;
  margin-top: 20rpx;
}

.sep { color: #3a3a3c; }

/* ==================== 10. Apple Summary Mask ==================== */
.apple-summary-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  z-index: 999;
}

.apple-summary-card {
  width: 100%;
  background: #1c1c1e;
  border-radius: 32rpx;
  padding: 48rpx 36rpx;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.summary-kicker {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #8e8e93;
  margin-bottom: 10rpx;
}

.summary-headline {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.summary-subline {
  font-size: 26rpx;
  color: #8e8e93;
  margin-bottom: 36rpx;
}

.summary-metric-grid {
  display: flex;
  background: #000000;
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  margin-bottom: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.metric-cell { flex: 1; }

.metric-value {
  font-size: 44rpx;
  font-weight: 700;
}

.metric-unit {
  font-size: 22rpx;
  font-weight: 400;
}

.metric-label {
  font-size: 22rpx;
  color: #8e8e93;
  margin-top: 6rpx;
}

.text-green { color: #34c759; }
.text-blue { color: #0a84ff; }
.text-amber { color: #ff9f0a; }

.summary-link-btn {
  font-size: 26rpx;
  color: #8e8e93;
  margin-top: 24rpx;
}

/* 绿色安全区与对焦锁定框 */
.calibrate-panel {
  margin: 36rpx 32rpx;
}
.viewfinder-green-zone {
  border: 2.5rpx solid #34c759 !important;
  box-shadow: 0 0 30rpx rgba(52, 199, 89, 0.25) !important;
}
.circle-green {
  border-color: #34c759 !important;
}
.line-green {
  border-color: #34c759 !important;
}
.green-safety-pill {
  background: rgba(52, 199, 89, 0.2) !important;
  border: 1.5rpx solid #34c759 !important;
  color: #34c759 !important;
  font-size: 24rpx !important;
  font-weight: 700 !important;
  padding: 10rpx 24rpx !important;
  border-radius: 20rpx !important;
  display: flex !important;
  align-items: center !important;
  gap: 12rpx !important;
}
.dot-green-live {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #34c759;
  box-shadow: 0 0 12rpx #34c759;
}
.btn-focus-trigger {
  font-size: 32rpx !important;
  letter-spacing: 1rpx !important;
}
.focus-hint-tip {
  font-size: 22rpx;
  color: #8e8e93;
  text-align: center;
  margin-top: 16rpx;
}
.demo-auto-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #2c2c2e;
  padding: 14rpx 20rpx;
  border-radius: 18rpx;
  margin-bottom: 16rpx;
}
.auto-label {
  font-size: 24rpx;
  color: #f1f5f9;
  font-weight: 600;
}

/* 真实前摄视频流与绿色安全区覆层 */
.real-camera-feed {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  border-radius: 28rpx;
  z-index: 1;
}

.camera-reticle-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  z-index: 10;
}

.virtual-feed-backup {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
