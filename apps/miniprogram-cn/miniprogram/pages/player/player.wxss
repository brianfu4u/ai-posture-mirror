/* miniprogram/pages/player/player.wxss */
.player-page {
  padding: 32rpx;
  background-color: #f8fafc;
  min-height: 100vh;
  box-sizing: border-box;
}

.player-header {
  margin-bottom: 24rpx;
}

.player-kicker {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #0284c7;
  text-transform: uppercase;
  display: block;
  margin-bottom: 6rpx;
}

.player-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 8rpx;
}

.player-sub {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

.tracking-screen-card {
  background: #0f172a;
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.15);
}

.tracking-viewport {
  width: 100%;
  height: 380rpx;
  background: #000000;
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #334155;
}

.track-axis {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  height: 2rpx;
  border-top: 1rpx dashed #334155;
}

.moving-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  background: #38bdf8;
  box-shadow: 0 0 20rpx #38bdf8;
  position: absolute;
  top: calc(50% - 18rpx);
  left: 10%;
  transition: transform 0.1s linear;
}

.dot-animated {
  animation: sweep 3s infinite alternate ease-in-out;
}

@keyframes sweep {
  0% { left: 10%; transform: scale(1); }
  50% { transform: scale(1.3); }
  100% { left: 85%; transform: scale(1); }
}

.tracking-timer {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: rgba(30, 41, 59, 0.8);
  color: #38bdf8;
  font-size: 24rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-family: monospace;
}

.stages-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid #e2e8f0;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.03);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.stage-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.stage-num {
  font-size: 24rpx;
  font-weight: 800;
  color: #0284c7;
  background: #e0f2fe;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}

.stage-meta {
  flex: 1;
}

.stage-head {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 4rpx;
}

.stage-desc {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.45;
}

.player-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn-play-trigger {
  background: #0284c7 !important;
  color: #ffffff !important;
  font-size: 30rpx !important;
  font-weight: 700 !important;
  border-radius: 44rpx !important;
  padding: 22rpx 0 !important;
  width: 100% !important;
}

.btn-pause {
  background: #475569 !important;
}

.btn-go-score {
  background: #0f172a !important;
  color: #ffffff !important;
  font-size: 30rpx !important;
  font-weight: 700 !important;
  border-radius: 44rpx !important;
  padding: 22rpx 0 !important;
  width: 100% !important;
}
