/* miniprogram/pages/profile/profile.wxss */
.profile-page {
  padding: 32rpx;
  background-color: #f8fafc;
  min-height: 100vh;
  box-sizing: border-box;
}

.user-card-head {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  border: 1rpx solid #e2e8f0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.03);
}

.avatar-large {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: #0284c7;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 800;
}

.user-details {
  flex: 1;
}

.user-main-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
}

.user-phone {
  font-size: 24rpx;
  color: #64748b;
  margin: 6rpx 0 10rpx 0;
}

.user-vip-pill {
  display: inline-block;
  background: #ecfdf5;
  color: #059669;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.section-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid #e2e8f0;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.03);
}

.card-head-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 20rpx;
}

.child-picker-row {
  display: flex;
  gap: 16rpx;
}

.child-card {
  flex: 1;
  background: #f8fafc;
  border: 1.5rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 20rpx 16rpx;
  transition: all 0.2s ease;
}

.child-selected {
  border-color: #0284c7;
  background: #f0f9ff;
}

.child-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 4rpx;
}

.child-desc {
  font-size: 20rpx;
  color: #64748b;
  line-height: 1.35;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.setting-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.setting-left {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.set-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
}

.set-sub {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.status-badge-ok {
  font-size: 20rpx;
  font-weight: 700;
  color: #059669;
  background: #ecfdf5;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}

.chevron {
  font-size: 32rpx;
  color: #94a3b8;
}

.order-item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.order-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.order-icon {
  font-size: 40rpx;
}

.order-meta {
  display: flex;
  flex-direction: column;
}

.order-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
}

.order-sub {
  font-size: 22rpx;
  color: #059669;
  margin-top: 4rpx;
}

.order-price {
  font-size: 28rpx;
  font-weight: 800;
  color: #0f172a;
}

.btn-contact-service {
  background: #f1f5f9 !important;
  color: #0f172a !important;
  font-size: 28rpx !important;
  font-weight: 700 !important;
  border-radius: 36rpx !important;
  padding: 20rpx 0 !important;
  border: 1rpx solid #e2e8f0 !important;
}
