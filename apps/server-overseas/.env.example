# Overseas Server Environment Configuration
PORT=8080
NODE_ENV=production

# LINE Messaging API Credentials (Japan & Taiwan parents)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# WhatsApp Cloud API Credentials (Singapore & Hong Kong parents)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_system_user_access_token_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here

# Brand Signature
BRAND_SIGNATURE="Designed in Tokyo, Japan · Made in Shanghai, China"
